# Cron auth: Vercel sends this as "Authorization: Bearer <value>" to /api/cron/dispatch-updates
CRON_SECRET=

# Public base URL used in the "Open Raghav's Workbench" links
NEXT_PUBLIC_APP_URL=https://opshub.example.com

# Slack: use a bot token (chat:write) to post to SLACK_CHANNEL, or an incoming webhook bound to one channel
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#ops-procurement

# Email via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="Freshroots OpsHub <digest@yourdomain.com>"
# Comma-separated: Raghav, Deepa, CEO, Procurement Head
DIGEST_RECIPIENTS="Raghav Kulkarni <raghav@yourdomain.com>, Deepa <deepa@yourdomain.com>, CEO <ceo@yourdomain.com>, Procurement Head <procurement.head@yourdomain.com>"

# Allow the Dispatch Center UI to send real messages in production (always allowed in dev)
ALLOW_MANUAL_DISPATCH=false

# Zoho Inventory (system of record for stock, cost, price and open POs)
# Data centre suffix of your Zoho account: in, com, eu, com.au, jp, ca or sa
ZOHO_DC=in
ZOHO_ORG_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Supabase (OpsHub project): used by `npm run seed:supabase`
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
